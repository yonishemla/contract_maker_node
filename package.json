{
  "name": "contract_maker_node",
  "version": "1.0.0",
  "description": "Local-only contract generation and e-sign backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "ensure:tables": "ts-node-dev --transpile-only src/scripts/ensureTables.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "openai": "^4.56.0",
    "pdf-lib": "^1.17.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.1",
    "@types/nodemailer": "^6.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
